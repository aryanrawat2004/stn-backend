PORT=5000
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Aadhaar OTP provider (AUA/Sub-AUA partner)
AADHAAR_PROVIDER_NAME=
AADHAAR_PROVIDER_BASE_URL=
AADHAAR_PROVIDER_API_KEY=
AADHAAR_PROVIDER_SEND_OTP_PATH=/aadhaar/generate-otp
AADHAAR_PROVIDER_VERIFY_OTP_PATH=/aadhaar/verify-otp
AADHAAR_PROVIDER_AUTH_HEADER=Authorization
AADHAAR_PROVIDER_AUTH_PREFIX=Bearer 
# Generate a long random secret used only to sign the short-lived browser flow state.
AADHAAR_FLOW_SECRET=
